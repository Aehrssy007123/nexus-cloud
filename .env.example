# ==========================================
# NEXUS CLOUD CONFIGURATION
# Setup Your Own Cloud for SaaS over LAN
# ==========================================

# Cloud Controller (Backend)
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Leave empty to use automatic in-memory MongoDB fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/nexus_cloud

# Apache Hadoop WebHDFS Configuration
# Default Hadoop 3.x NameNode WebHDFS URL
HDFS_URL=http://localhost:9870/webhdfs/v1
HDFS_USER=hdfs

# Optional: Override DataNode Host if running in Docker container with internal hostnames
# HDFS_DATANODE_HOST_OVERRIDE=localhost

# Security
JWT_SECRET=nexus_cloud_super_secret_jwt_key_2026
